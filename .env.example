EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# If Auth says "Invalid API key": Dashboard → Project Settings → API Keys →
# open "Legacy anon, service_role API keys" → copy the anon "public" JWT (eyJ... one line).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The client uses ANON if set, otherwise publishable. Do not commit real keys.
